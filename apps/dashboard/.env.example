NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_STORE_ID=S-01
# Dev only, with the API in AUTH_MODE=dev: skips the store-team sign-in page and signs in as the
# seeded store manager. Use dev:admin-demo for the SmartCart admin team's Account approvals page.
# Leave it unset to sign in with a staff ID or phone and password, as real builds do.
NEXT_PUBLIC_DEV_AUTH_TOKEN=dev:staff-demo
