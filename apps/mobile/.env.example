# Where the app finds the API. On a real phone use your laptop's LAN IP (same Wi-Fi).
# Android emulator: http://10.0.2.2:4000
EXPO_PUBLIC_API_URL=http://192.168.1.20:4000
# Shopper sign-in (Google, Apple, phone OTP) needs the Firebase project. Until it exists, leave this
# unset and the app offers test sign-in instead.
# EXPO_PUBLIC_FIREBASE_API_KEY=
