# Copy to .env for local development. Never commit real secrets.
DATABASE_URL=postgresql://smartcart:smartcart@localhost:5432/smartcart
REDIS_URL=redis://localhost:6379
PORT=4000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
# "dev" accepts bearer tokens of the form dev:<uid>. Use "firebase" with a project id for real sign-in.
AUTH_MODE=dev
# FIREBASE_PROJECT_ID=smart-cart-xxxxx
# "fake" pays orders through POST /v1/orders/{id}/pay/fake, for development and demos.
# "stripe" uses Stripe (test keys start sk_test_/pk_test_). Put real keys only in your local .env
# or the deployment's secret store; never commit them or paste them into chat.
PAYMENT_PROVIDER=fake
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Ask SmartCart uses Claude when this is set, and answers from store data by rules without it.
# Like the Stripe keys, keep it in your local .env or the secret store only.
# ANTHROPIC_API_KEY=sk-ant-...
