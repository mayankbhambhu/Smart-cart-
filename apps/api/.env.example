# Copy to .env for local development. Never commit real secrets.
DATABASE_URL=postgresql://smartcart:smartcart@localhost:5432/smartcart
REDIS_URL=redis://localhost:6379
PORT=4000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
# "dev" accepts bearer tokens of the form dev:<uid>. Use "firebase" with a project id for real sign-in.
AUTH_MODE=dev
# FIREBASE_PROJECT_ID=smart-cart-xxxxx
# Signs store-team session tokens (staff ID or phone + password, 12 hours). Required in production,
# 32+ random characters, kept in the secret store. Development falls back to a fixed dev value.
# SESSION_SECRET=
# How temporary staff passwords are texted. "log" returns the message in the API response and logs
# it, for development and demos; production needs a real SMS provider (not chosen yet).
SMS_PROVIDER=log
# "fake" pays orders through POST /v1/orders/{id}/pay/fake, for development and demos.
# "stripe" uses Stripe (test keys start sk_test_/pk_test_). Put real keys only in your local .env
# or the deployment's secret store; never commit them or paste them into chat.
PAYMENT_PROVIDER=fake
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Ask SmartCart uses Claude when this is set, and answers from store data by rules without it.
# Like the Stripe keys, keep it in your local .env or the secret store only.
# ANTHROPIC_API_KEY=sk-ant-...
# Carts and exit gates sign their readings (x-device-key) with keys derived from this. Required in
# production, 32+ random characters, in the secret store. `python -m smartcart.cart_sim` uses it too.
# CART_DEVICE_SECRET=
# "json" writes one JSON object per log line with the request id, for CloudWatch; "text" for a terminal.
LOG_FORMAT=text
# Unhandled errors go to Sentry when this is set (credentials and request bodies are stripped).
# SENTRY_DSN=
# Per-caller rate limits on sign-in, the assistant, search, help and cart hardware.
RATE_LIMITS=true
# RATE_LIMIT_SCALE=1
# Load balancers in front of the API (1 behind an AWS ALB), so limits see the shopper's address.
PROXY_HOPS=0
