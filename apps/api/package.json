{
  "name": "@smart-cart/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "rm -rf dist && prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "seed:generate-catalog": "tsx prisma/generate-catalog.ts",
    "db:seed:prod": "node dist/prisma/seed.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@prisma/client": "6.19.3",
    "@smart-cart/contracts": "workspace:*",
    "fastify": "^5.12.7",
    "ioredis": "^5.11.1",
    "prisma": "6.19.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  }
}
