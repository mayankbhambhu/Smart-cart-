{
  "name": "smart-cart",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev:api": "pnpm --filter @smart-cart/api dev",
    "dev:dashboard": "pnpm --filter @smart-cart/dashboard dev",
    "db:migrate": "pnpm --filter @smart-cart/api db:migrate",
    "db:seed": "pnpm --filter @smart-cart/api db:seed"
  }
}
