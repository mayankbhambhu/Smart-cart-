{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "storeId": {
      "type": "string"
    },
    "carts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cartId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "available",
              "in_use",
              "maintenance"
            ]
          },
          "sessionId": {
            "type": [
              "string",
              "null"
            ]
          },
          "shopperName": {
            "type": [
              "string",
              "null"
            ]
          },
          "startedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "batteryPct": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "weightG": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "aisle": {
            "type": [
              "string",
              "null"
            ]
          },
          "seenAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "faults": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "scale_error",
                "scanner_error",
                "beacon_lost",
                "lid_open",
                "low_battery",
                "offline"
              ]
            }
          },
          "weightCheck": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "ok",
                  "extra",
                  "missing",
                  "unknown"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "openAlerts": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "cartId",
          "status",
          "sessionId",
          "shopperName",
          "startedAt",
          "batteryPct",
          "weightG",
          "aisle",
          "seenAt",
          "faults",
          "weightCheck",
          "openAlerts"
        ]
      }
    }
  },
  "required": [
    "storeId",
    "carts"
  ]
}
