{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "reservation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "storeId": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "reserved",
            "picked",
            "collected",
            "expired",
            "cancelled"
          ]
        },
        "slotStart": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "slotEnd": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "cartCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "shopperName": {
          "type": [
            "string",
            "null"
          ]
        },
        "pickedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "productId": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "qty": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "pickedQty": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "aisle": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "shelf": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "pricePaise": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "productId",
              "name",
              "qty",
              "pickedQty",
              "aisle",
              "shelf",
              "pricePaise"
            ]
          }
        },
        "itemCount": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "totalPaise": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "createdAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "pickedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "closedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "storeId",
        "status",
        "slotStart",
        "slotEnd",
        "cartCode",
        "shopperName",
        "pickedBy",
        "items",
        "itemCount",
        "totalPaise",
        "createdAt",
        "pickedAt",
        "closedAt"
      ]
    },
    "cart": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string"
        },
        "cartCode": {
          "type": "string",
          "pattern": "^C-\\d{4,}$"
        },
        "storeId": {
          "type": "string",
          "pattern": "^S-\\d{2,}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "checking_out",
            "paid",
            "abandoned"
          ]
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "productId": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "brand": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "imageUrl": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "qty": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "unitPricePaise": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "gstRateBp": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              },
              "lineTotalPaise": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "lineTaxPaise": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "productId",
              "name",
              "brand",
              "imageUrl",
              "qty",
              "unitPricePaise",
              "gstRateBp",
              "lineTotalPaise",
              "lineTaxPaise"
            ]
          }
        },
        "totals": {
          "type": "object",
          "properties": {
            "totalPaise": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "taxPaise": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "subtotalPaise": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "itemCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "totalPaise",
            "taxPaise",
            "subtotalPaise",
            "itemCount"
          ]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        }
      },
      "required": [
        "sessionId",
        "cartCode",
        "storeId",
        "status",
        "lines",
        "totals",
        "updatedAt"
      ]
    }
  },
  "required": [
    "reservation",
    "cart"
  ]
}
