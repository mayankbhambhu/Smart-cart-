{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "storeId": {
      "type": "string"
    },
    "aisle": {
      "type": [
        "string",
        "null"
      ]
    },
    "offers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "productId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "brand": {
            "type": [
              "string",
              "null"
            ]
          },
          "foodType": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "veg",
                  "non_veg",
                  "egg",
                  "not_food"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "aisle": {
            "type": [
              "string",
              "null"
            ]
          },
          "shelf": {
            "type": [
              "string",
              "null"
            ]
          },
          "stock": {
            "type": "string",
            "enum": [
              "in_stock",
              "low",
              "out",
              "unknown"
            ]
          },
          "offerPricePaise": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "regularPaise": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "savingsPaise": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "endsAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "id",
          "title",
          "productId",
          "name",
          "brand",
          "foodType",
          "aisle",
          "shelf",
          "stock",
          "offerPricePaise",
          "regularPaise",
          "savingsPaise",
          "endsAt"
        ]
      }
    }
  },
  "required": [
    "storeId",
    "aisle",
    "offers"
  ]
}
