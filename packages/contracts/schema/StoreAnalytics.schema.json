    },
    "summary": {
      "type": "object",
      "properties": {
        "orders": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "revenuePaise": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "avgBasketPaise": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "avgItems": {
          "type": [
            "number",
            "null"
          ]
        },
        "medianMinutesToPay": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "orders",
        "revenuePaise",
        "avgBasketPaise",
        "avgItems",
        "medianMinutesToPay"
      ]
    },
    "byHour": {
      "minItems": 24,
      "maxItems": 24,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "hour": {
            "type": "integer",
            "minimum": 0,
            "maximum": 23
          },
          "orders": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "revenuePaise": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "hour",
          "orders",
          "revenuePaise"
        ]
      }
    },
    "byDay": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
