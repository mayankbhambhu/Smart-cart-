            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "revenuePaise": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "date",
          "orders",
          "revenuePaise"
        ]
      }
    },
    "topProducts": {
      "type": "array",
