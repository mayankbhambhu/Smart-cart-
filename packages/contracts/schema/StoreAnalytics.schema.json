          "share": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "section",
          "revenuePaise",
          "share"
        ]
      }
    },
    "deals": {
      "type": "object",
      "properties": {
        "ordersWithDeal": {
          "type": "integer",
          "minimum": 0,
