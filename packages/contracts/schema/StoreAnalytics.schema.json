                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              "running": {
                "type": "boolean"
              },
              "unitsDuring": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "unitsBefore": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "unitsPerDayDuring": {
                "type": "number"
              },
              "unitsPerDayBefore": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "upliftPct": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "offerId",
              "productId",
              "name",
              "title",
              "startsAt",
              "endsAt",
              "running",
              "unitsDuring",
              "unitsBefore",
              "unitsPerDayDuring",
              "unitsPerDayBefore",
              "upliftPct"
            ]
          }
        }
      },
      "required": [
        "ordersWithDeal",
        "dealShare",
        "dealUnits",
        "savingsPaise",
        "offers"
      ]
    },
    "busyAisles": {
      "type": "array",
