          "productId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "qty": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "revenuePaise": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
